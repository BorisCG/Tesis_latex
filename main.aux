\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Collision and relaxation timescales in a mass versus radius diagram. Dashed lines correspond to the critical mass $M_{\rm  crit}$, while solid lines correspond to the relaxation mass $M_{\rm  relax}$, both calculated for solar-mass clusters. The colours represent two different characteristic timescales: blue for $t_{\rm  H}=5 \times 10^6~{\rm  yr}$, and red for $t_{\rm  H}=10^{10}~{\rm  yr}$. The black dash-dotted line represents $t_{\rm  coll} = t_{\rm  relax}$, with $t_{\rm  H}$ varying from $10^2$ yr to $10^{10}$ yr. Clusters above the black dash-dotted line satisfy $t_{\rm  coll} \leq t_{\rm  relax}$. For each color, the collisional regime (CR) is defined by $t_{\rm  coll} \leq t_{\rm  H} \leq t_{\rm  relax}$ (green colored zone); the stable regime is where $t_{\rm  relax} \leq t_{\rm  H} \leq t_{\rm  coll}$; and the intermediate regime (IR) fulfils $t_{\rm  relax} \leq t_{\rm  coll} \leq t_{\rm  H}$.}}{6}{figure.caption.11}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{img:Collisional_regime}{{2.1}{6}{Collision and relaxation timescales in a mass versus radius diagram. Dashed lines correspond to the critical mass $M_{\rm crit}$, while solid lines correspond to the relaxation mass $M_{\rm relax}$, both calculated for solar-mass clusters. The colours represent two different characteristic timescales: blue for $t_{\rm H}=5 \times 10^6~{\rm yr}$, and red for $t_{\rm H}=10^{10}~{\rm yr}$. The black dash-dotted line represents $t_{\rm coll} = t_{\rm relax}$, with $t_{\rm H}$ varying from $10^2$ yr to $10^{10}$ yr. Clusters above the black dash-dotted line satisfy $t_{\rm coll} \leq t_{\rm relax}$. For each color, the collisional regime (CR) is defined by $t_{\rm coll} \leq t_{\rm H} \leq t_{\rm relax}$ (green colored zone); the stable regime is where $t_{\rm relax} \leq t_{\rm H} \leq t_{\rm coll}$; and the intermediate regime (IR) fulfils $t_{\rm relax} \leq t_{\rm coll} \leq t_{\rm H}$}{figure.caption.11}{}}
